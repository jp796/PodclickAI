{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "podclick",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "PODCLICK_DEPLOYMENT_MODE=local",
        "venv/bin/uvicorn",
        "main:app",
        "--host",
        "127.0.0.1",
        "--no-proxy-headers",
        "--port",
        "8765"
      ],
      "port": 8765,
      "autoPort": false
    },
    {
      "name": "podcast-studio-ui",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--bind",
        "127.0.0.1",
        "--directory",
        "frontend"
      ],
      "port": 8766
    }
  ]
}

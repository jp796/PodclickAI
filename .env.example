# Copy this file to .env and fill in your values

# Explicit local-only access. Do not set local on a public deployment or tunnel.
# Start with --host 127.0.0.1 --no-proxy-headers. Missing mode defaults locked.
PODCLICK_DEPLOYMENT_MODE=local

# Billing remains disabled until verified customer authentication is integrated.
# Add real values through your secret manager, never source control.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_IDS={}
STRIPE_API_VERSION=2025-02-24.acacia
PODCLICK_PUBLIC_URL=

# Required: OpenAI API key (for GPT-4o title/description generation)
OPENAI_API_KEY=sk-...

# Optional: Spotify login is handled automatically via the browser window.
# Cookies are saved to data/spotify_cookies.json after first login.

# Owner background automation (Brick's 04:00 planning cron, nightly Foundation
# recompute, release scheduler, autopilot worker) in a DEPLOYED install.
# Scheduling only — the HTTP/WS perimeter is governed by PODCLICK_DEPLOYMENT_MODE
# and is unaffected. Leave unset for local dev (local mode enables them already).
PODCLICK_OWNER_AUTOMATION=
